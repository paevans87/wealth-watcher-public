# Copy this file to .env before starting Docker Compose. Never commit .env.

POSTGRES_USER=wealthwatcher
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=wealthwatcherdb

# Persistent ASP.NET Data Protection keys. Keep this directory backed up and private.
CONFIG_PATH=./config

# Optional published image overrides. Leave unset to build the application images locally.
# API_IMAGE=ghcr.io/paevans87/wealth-watcher-public-api:main
# WEB_IMAGE=ghcr.io/paevans87/wealth-watcher-public-web:main

# Optional outbound webhook relay. The relay is a separate image and is not
# included in the private Wealth Watcher stack by default.
WEBHOOK_RELAY_ENABLED=false
# WEBHOOK_RELAY_URL=wss://relay.example.com/ws
# WEBHOOK_RELAY_HTTP_URL=https://relay.example.com
# WEBHOOK_RELAY_INSTALLATION_ID=replace-with-a-private-api-relay-pairing-id
# WEBHOOK_RELAY_TOKEN=replace-with-a-long-random-secret
# Provider-facing relay base URL (for example an HTTPS reverse proxy or ngrok URL).
# Provider webhook URLs use /webhooks/<provider>; this must be the relay URL, not the API URL.
# WEBHOOK_RELAY_PUBLIC_BASE_URL=https://relay.example.com

# Optional standalone relay Compose settings. These are only read by
# docker-compose.relay.yml; keep the provider key and relay token private.
# RELAY_IMAGE=ghcr.io/paevans87/wealth-watcher-public-webhook-relay:main
# RELAY_INSTALLATION_ID=replace-with-a-private-api-relay-pairing-id
# RELAY_TOKEN=replace-with-a-long-random-secret
# SNAPTRADE_CONSUMER_KEY=replace-with-snaptrade-consumer-key
# RELAY_DATA_PATH=./relay-data
# RELAY_BIND_ADDRESS=127.0.0.1
# RELAY_PORT=8080

# Optional stable Compose project name. Keep this stable when using named volumes.
# COMPOSE_PROJECT_NAME=wealth-watcher

# Keep published services local by default. Change deliberately for a trusted LAN.
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432
API_PORT=5000
WEB_PORT=8182

# Optional extra UI origins when the UI is hosted at a non-default address.
# CORS_ALLOWED_ORIGIN_0=http://localhost:8182
# CORS_ALLOWED_ORIGIN_1=http://127.0.0.1:8182
