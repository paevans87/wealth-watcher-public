# Copy this file to .env before starting Docker Compose. Never commit .env.

POSTGRES_USER=wealthwatcher
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=wealthwatcherdb

# Persistent ASP.NET Data Protection keys. Keep this directory backed up and private.
CONFIG_PATH=./config

# Optional published image overrides. Leave unset to build the application images locally.
# API_IMAGE=ghcr.io/paevans87/wealth-watcher-public-api:main
# WEB_IMAGE=ghcr.io/paevans87/wealth-watcher-public-web:main

# Optional stable Compose project name. Keep this stable when using named volumes.
# COMPOSE_PROJECT_NAME=wealth-watcher

# Keep published services local by default. Change deliberately for a trusted LAN.
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432
API_PORT=5000
WEB_PORT=8182

# Optional extra UI origins when the UI is hosted at a non-default address.
# CORS_ALLOWED_ORIGIN_0=http://localhost:8182
# CORS_ALLOWED_ORIGIN_1=http://127.0.0.1:8182
